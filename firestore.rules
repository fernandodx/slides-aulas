rules_version = '2';

// ===============================================================
// Data Model
// ===============================================================
//
// Collection: /seminars/{courseId}/topics/{topicId}
// Document ID: {topicId} (e.g. 'rest-apis', 'angular-framework')
// Fields:
//   - topicId:     string   — identifier of the topic
//   - topicTitle:  string   — display title of the topic
//   - students:    list     — names of registered students (1..maxStudents)
//   - maxStudents: int      — max allowed students for this topic (1..10)
//   - status:      string   — 'open' | 'full'  (legacy: 'claimed')
//   - claimedAt:   timestamp — when the first student registered
//   - updatedAt:   timestamp — when the last student joined (update only)
//   - userAgent:   string   — browser client identifier (optional)
//
// Lifecycle:
//   CREATE  — first student(s) register; document does not exist yet.
//   UPDATE  — additional students join an open group (status was 'open').
//             Only 'students', 'status', and 'updatedAt' may change.
//             'claimedAt', 'topicId', 'topicTitle', 'maxStudents' are immutable.
//   DELETE  — never allowed.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────

    function isValidStatus(s) {
      return s == 'open' || s == 'full' || s == 'claimed';
    }

    function isValidStudentList(students, maxStudents) {
      return students is list
        && students.size() >= 1
        && students.size() <= maxStudents;
    }

    // Validates a brand-new registration document (create).
    function isValidCreate() {
      let d = request.resource.data;
      return d.keys().hasAll(['topicId', 'topicTitle', 'students', 'maxStudents', 'status', 'claimedAt'])
        && d.topicId    is string    && d.topicId.size()    >  0 && d.topicId.size()    <= 100
        && d.topicTitle is string    && d.topicTitle.size() >  0 && d.topicTitle.size() <= 200
        && d.maxStudents is int      && d.maxStudents >= 1       && d.maxStudents <= 10
        && isValidStudentList(d.students, d.maxStudents)
        && isValidStatus(d.status)
        && d.claimedAt is timestamp;
    }

    // Validates a student-join update.
    // Only 'students', 'status', and 'updatedAt' may change.
    // The topic must currently be open (not full).
    // The new student list must be larger than the existing one (append-only).
    function isValidJoin() {
      let before = resource.data;
      let after  = request.resource.data;

      // Immutable fields must not change
      let immutableUnchanged =
        after.topicId    == before.topicId
        && after.topicTitle == before.topicTitle
        && after.maxStudents == before.maxStudents
        && after.claimedAt  == before.claimedAt;

      // Topic must currently be open (below capacity)
      let wasOpen = before.students.size() < before.maxStudents;

      // Students list must grow (append-only, no removals)
      let studentsGrew = after.students.size() > before.students.size();

      // New list must still respect the cap
      let withinCap = isValidStudentList(after.students, before.maxStudents);

      // Status must be valid
      let statusValid = isValidStatus(after.status);

      return immutableUnchanged && wasOpen && studentsGrew && withinCap && statusValid;
    }

    // ── seminar topic rules ───────────────────────────────────────

    match /seminars/{courseId}/topics/{topicId} {
      // Public read — students see live availability in real-time
      allow read: if true;

      // First-come first-served creation
      allow create: if resource == null && isValidCreate();

      // Additional students may join while the group is open
      allow update: if resource != null && isValidJoin();

      // Topics are never deleted by clients
      allow delete: if false;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
